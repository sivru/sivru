{
  "name": "sivru-monorepo",
  "version": "0.14.0",
  "private": true,
  "description": "Sivru — the comprehension layer for AI-written code: authored-intent blocks, a repo-wide explainer model, and an architectural drift gate. Local, MCP-native.",
  "license": "MIT",
  "homepage": "https://github.com/sivru/sivru",
  "repository": {
    "type": "git",
    "url": "https://github.com/sivru/sivru.git"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "qa": "pnpm -r build && pnpm -r typecheck && pnpm -r test",
    "lint": "pnpm -r lint",
    "bench": "pnpm --filter benchmarks run bench",
    "bench:tthw": "pnpm --filter sivru run bench:tthw",
    "bench:agent": "pnpm --filter benchmarks run bench:agent",
    "sivru": "node packages/cli/dist/index.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
